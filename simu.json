    {
        "id": "ee9d1ad4530f3209",
        "type": "ui_template",
        "z": "f0be47c5445a01d0",
        "group": "cf7ef1821d496357",
        "name": "",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<md-button class=\"md-raised md-primary\"\n           ng-click=\"telechargerCSV()\">\n    Télécharger CSV\n</md-button>\n\n<script>\n(function(scope) {\n    let demandeEnCours = null;\n\n    scope.telechargerCSV = function() {\n        demandeEnCours = Date.now() + \"-\" + Math.random();\n\n        scope.send({\n            topic: \"telecharger_csv\",\n            requestId: demandeEnCours\n        });\n    };\n\n    scope.$watch(\"msg\", function(msg) {\n        // Accepter seulement la réponse à notre clic.\n        if (!msg || !demandeEnCours ||\n            msg.requestId !== demandeEnCours ||\n            typeof msg.payload !== \"string\") {\n            return;\n        }\n\n        demandeEnCours = null;\n\n        const fichier = new Blob(\n            [msg.payload],\n            { type: \"text/csv;charset=utf-8;\" }\n        );\n\n        const url = URL.createObjectURL(fichier);\n        const lien = document.createElement(\"a\");\n\n        lien.href = url;\n        lien.download = msg.filename || \"historique.csv\";\n\n        document.body.appendChild(lien);\n        lien.click();\n        lien.remove();\n\n        setTimeout(function() {\n            URL.revokeObjectURL(url);\n        }, 1000);\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
