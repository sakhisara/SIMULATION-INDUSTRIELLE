    {
        "id": "7a3edfc094257fa5",
        "type": "function",
        "z": "f0be47c5445a01d0",
        "name": "Alerte et graphique.",
        "func": "const d = msg.payload;\n\n// 1 : voyant\nconst voyant = {\n    payload: d.alerte === true\n};\n\n// 2 : annonce uniquement au déclenchement de l'alerte\nconst active = d.alerte === true;\nconst precedente = context.get(\"alertePrecedente\") === true;\n\nlet voix = null;\n\nif (active && !precedente) {\n    voix = {\n        payload: \"Attention, taux de défaut élevé : \"\n            + String(d.taux_defaut).replace(\".\", \",\")\n            + \" pour cent.\"\n    };\n}\n\ncontext.set(\"alertePrecedente\", active);\n\n// 3 : deux courbes dans un seul graphique\nconst conformes = {\n    topic: \"Stock conforme\",\n    payload: d.stock_conforme\n};\n\nconst rejets = {\n    topic: \"Rejets\",\n    payload: d.rejets\n};\n\nreturn [voyant, voix, [conformes, rejets]];\nreturn msg;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
