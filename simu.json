    {
        "id": "f614cd25eef141f8",
        "type": "function",
        "z": "f0be47c5445a01d0",
        "name": "function : Historique CSV",
        "func": "const colonnes = [\n    \"date_heure_UTC\",\n    \"en_marche\",\n    \"produits_generes\",\n    \"produits_emballes\",\n    \"stock_conforme\",\n    \"rejets\",\n    \"taux_defaut\",\n    \"attente_emballage\",\n    \"attente_controle\",\n    \"vitesse_px_s\"\n];\n\nlet lignes = context.get(\"lignesCSV\") || [];\n\n// Le bouton demande le téléchargement.\nif (msg.topic === \"telecharger_csv\") {\n    msg.payload = \"\\uFEFF\" + colonnes.join(\";\") + \"\\r\\n\"\n        + lignes.join(\"\\r\\n\") + \"\\r\\n\";\n\n    msg.filename = \"historique_\" + Date.now() + \".csv\";\n    return msg;\n}\n\n// Réception des données de la simulation.\nconst d = msg.payload;\n\nif (!d || typeof d !== \"object\") return null;\n\nconst maintenant = Date.now();\nconst dernier = context.get(\"dernierEnregistrementCSV\");\n\n// Conserver une mesure toutes les 5 secondes.\nif (dernier !== undefined && maintenant - dernier < 5000) {\n    return null;\n}\n\ncontext.set(\"dernierEnregistrementCSV\", maintenant);\n\nconst valeurs = [\n    new Date(maintenant).toISOString(),\n    ...colonnes.slice(1).map(cle => d[cle])\n];\n\nconst ligne = valeurs.map(valeur =>\n    '\"' + String(valeur ?? \"\").replace(/\"/g, '\"\"') + '\"'\n).join(\";\");\n\nlignes.push(ligne);\ncontext.set(\"lignesCSV\", lignes);\n\n// Aucun téléchargement automatique.\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 880,
        "wires": [
            [
                "ee9d1ad4530f3209"
            ]
        ]
    },
